# ── 環境変数 ──────────────────────────────────────────────────────────────────
.env

# ── 出力ファイル（大容量 / 生成物） ─────────────────────────────────────────
downloads/
transcriptions/
clips/
exports/
web/transcriptions/
studio.log
launcher.log

# ── Windows パッケージングのビルド出力（APIキーを含み得る default_config.json も含む） ──
dist/
web/default_config.json

# ── ローカル実行時に生成される設定データ（config.py / theme_store.py が get_data_dir() に書く） ──
config.json
custom_themes.json
themes_store.json

# ── Remotion 生成物 ───────────────────────────────────────────────────────────
remotion/node_modules/
remotion/out/
remotion/studio-props.json

# remotion/public/ 配下は本来ビルド生成物ではなく、ClipComposition.tsx / CaptionPage.tsx が
# staticFile() で参照する必須アセット（Onoma-Pop04.mp3, kkrn_icon_user_2.png）を置く場所。
# 丸ごとignoreしているとCIのチェックアウトが空になり、Windowsパッケージ版で
# 「Onoma-Pop04.mp3: 404」のようなレンダー失敗を起こす（pipeline.render_clip / app._sync_studio_src
# はファイルが無ければ黙ってコピーをスキップするため）。ここに置く新規ファイルは追跡対象にする。
remotion/public/*.DS_Store

# Remotion Studio が実行時に自動生成するファイル
remotion/src/studioCompositions.tsx
remotion/src/studioData.json
remotion/src/transcription.json

# Studio 用の使い捨てソースコピー（app.py の _sync_studio_src が毎回作り直す）
remotion/studio-src/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── yt-dlp 一時ファイル ───────────────────────────────────────────────────────
*.ytdl

# ── Claude Code ───────────────────────────────────────────────────────────────
skills-lock.json
.agents/
.claude/
.omc/

